<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Pokedex.Models"
             x:Class="Pokedex.Views.PokemonListaPage"
             Title="Pokédex"
             BackgroundColor="AliceBlue">
    <Grid Padding="16"
      RowDefinitions="Auto,*"
      RowSpacing="12">

        <Button Text="Cadastrar Pokémon"
            Clicked="OnCadastrarClicked" 
            BackgroundColor="BlueViolet"
            TextColor="Black"
                />

        <CollectionView Grid.Row="1"
                    x:Name="PokemonsCollection"
                    SelectionMode="None"
                    EmptyView="Nenhum Pokémon cadastrado.">

            <CollectionView.ItemTemplate>
                
                <DataTemplate x:DataType="models:Pokemon"
                              >

                    <Grid Padding="8"
                      ColumnDefinitions="80,*"
                      ColumnSpacing="20"
                          BackgroundColor="Black">

                        <Image Source="{Binding Imagem}"
                           HeightRequest="72"
                           Aspect="AspectFit" 
                               Background="BlueViolet"/>

                        <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center">
                            <Label Text="{Binding Nome1}"
                               FontSize="20" />
                            <Label Text="{Binding Tipo1}"
                               FontSize="14" />
                            
                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>